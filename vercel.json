{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix landing",
  "buildCommand": "npm run build --prefix landing",
  "outputDirectory": "landing/dist/client",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
